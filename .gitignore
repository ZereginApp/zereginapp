# ============================================
# Variables de entorno (nunca subir valores reales)
# ============================================
.env
.env.*
!.env.example

# ============================================
# Dependencias
# ============================================
vendor/
node_modules/

# ============================================
# Backend (Laravel)
# Laravel genera además su propio backend/.gitignore
# ============================================
backend/public/build/
backend/public/hot
backend/public/storage
backend/storage/*.key
backend/.phpunit.result.cache
backend/.phpunit.cache/

# ============================================
# Frontend (Angular)
# Angular genera además su propio frontend/.gitignore
# ============================================
frontend/dist/
frontend/.angular/
frontend/coverage/

# ============================================
# Docker y Traefik
# ============================================
# Certificados HTTPS generados por Traefik en el servidor
docker/traefik/acme.json
docker/traefik/certs/

# ============================================
# Registros
# ============================================
*.log
npm-debug.log*

# ============================================
# Editores
# ============================================
.vscode/*
!.vscode/extensions.json
.idea/
*.swp

# ============================================
# Sistema operativo
# ============================================
.DS_Store
Thumbs.db
desktop.ini