# =====================================================================
# Variables de entorno de Docker Compose
# Copia este archivo como .env y rellena los valores. NUNCA subas el .env.
#
# Laravel tiene además su propio backend/.env. Los datos de la base de datos
# de este archivo deben coincidir con los DB_* de backend/.env.
# =====================================================================

# Nombre del proyecto en Docker (prefijo de contenedores, redes y volúmenes)
COMPOSE_PROJECT_NAME=zereginapp

# Zona horaria de los contenedores. Importante: las tareas se gestionan por fecha y hora.
TZ=Europe/Madrid

# ---------------------------------------------------------------------
# Dominio y Traefik
# ---------------------------------------------------------------------
# En local: localhost. En el servidor del centro: el dominio real.
APP_DOMAIN=localhost

# Puertos expuestos por Traefik en tu equipo
HTTP_PORT=80
HTTPS_PORT=443

# Solo producción: email asociado a los certificados HTTPS
TRAEFIK_ACME_EMAIL=

# ---------------------------------------------------------------------
# Base de datos (MySQL)
# ---------------------------------------------------------------------
MYSQL_DATABASE=zereginapp
MYSQL_USER=zereginapp
MYSQL_PASSWORD=cambia_esta_contrasena
MYSQL_ROOT_PASSWORD=cambia_esta_otra_contrasena

# Puerto de MySQL en tu equipo, para conectarte con un cliente como DBeaver o MySQL Workbench.
# Si ya tienes MySQL instalado y usando el 3306, cambia este valor (por ejemplo, 3307).
MYSQL_PORT=3306
