APP_NAME=ZereginApp
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost:8000

APP_LOCALE=es
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=es_ES
APP_TIMEZONE=Europe/Madrid

APP_MAINTENANCE_DRIVER=file

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

# Deben coincidir con los MYSQL_* del .env de la raíz.
# Mientras no exista el Docker Compose, en tu .env local puedes usar
# DB_CONNECTION=sqlite y comentar el resto de DB_*.
DB_CONNECTION=mysql
DB_HOST=db
DB_PORT=3306
DB_DATABASE=zereginapp
DB_USERNAME=zereginapp
DB_PASSWORD=cambia_esta_password

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=database

CACHE_STORE=database

MAIL_MAILER=log
MAIL_SCHEME=null
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="no-reply@zereginapp.duckdns.org"
MAIL_FROM_NAME="${APP_NAME}"
